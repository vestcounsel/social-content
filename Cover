<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Vest Counsel cover slide</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0c0c0c; --paper:#ffffff; --red:#b32600;
    --gray:#808080; --charcoal:#282828; --cream:#edeae3;
    --ml:88px;                 /* left and right margin */
    --asc:0.968; --em:1.219;   /* Montserrat metrics, do not edit */
  }
  body{ margin:0; background:#f3f3f1; }

  .slide{
    position:relative; width:1080px; height:1350px; overflow:hidden;
    font-family:'Montserrat',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .slide.bg-paper   { background:var(--paper);    color:var(--ink);   --bg:var(--paper);    --accent:var(--red);   }
  .slide.bg-cream   { background:var(--cream);    color:var(--ink);   --bg:var(--cream);    --accent:var(--red);   }
  .slide.bg-ink     { background:var(--ink);      color:var(--paper); --bg:var(--ink);      --accent:var(--paper); }
  .slide.bg-charcoal{ background:var(--charcoal); color:var(--paper); --bg:var(--charcoal); --accent:var(--paper); }
  .slide.bg-gray    { background:var(--gray);     color:var(--paper); --bg:var(--gray);     --accent:var(--paper); }
  .slide.bg-red     { background:var(--red);      color:var(--paper); --bg:var(--red);      --accent:var(--paper); }

  /* Baseline anchoring. .bl-top pins the first baseline, .bl-bot the last. */
  .bl-top,.bl-bot{
    position:absolute; left:var(--ml); right:var(--ml); margin:0;
    font-size:calc(var(--fs) * 1px); line-height:var(--lh);
    font-weight:700; white-space:pre;
  }
  .bl-top{ top:calc((var(--bl) - ((var(--lh) - var(--em))/2 + var(--asc)) * var(--fs)) * 1px); }
  .bl-bot{ bottom:calc((1350 - (var(--bl) + ((var(--lh) - var(--em))/2 + 0.251) * var(--fs))) * 1px); }

  .wordmark{ --fs:48; --lh:1; --bl:166.2;
             letter-spacing:.105em; text-transform:uppercase; opacity:.42; }
  .slide.bg-paper .wordmark,
  .slide.bg-cream .wordmark{ opacity:1; color:var(--gray); }

  .display { --fs:120; --lh:1.35; --bl:1263; }
</style>
</head>
<body>

<!-- =======================================================================
     EDIT HERE.
     Backgrounds:  bg-paper  bg-cream  bg-ink  bg-charcoal  bg-gray  bg-red
     Never indent a continuation line. Use &amp;rsquo; for an apostrophe.
     ======================================================================= -->

<div class="slide bg-ink">

  <p class="bl-top wordmark">Vest Counsel</p>

  <h1 class="bl-bot display">Lana Del Rey&rsquo;s
IP Empire</h1>

</div>

<script>
/* Auto-fit: shrinks a line only if it would cross the margin.
   Set lock to a number to force one fixed size on every slide. */
const FIT = [
  { sel:'.display', max:120, min:72, lock:null }
];

function widestLine(el, fs){
  const cs = getComputedStyle(el);
  const probe = document.createElement('span');
  probe.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;' +
    `font:${cs.fontWeight} ${fs}px Montserrat,sans-serif;`;
  document.body.appendChild(probe);
  let w = 0;
  for (const line of el.textContent.split('\n')){
    probe.textContent = line;
    w = Math.max(w, probe.getBoundingClientRect().width);
  }
  probe.remove();
  return w;
}

document.fonts.ready.then(() => {
  for (const role of FIT){
    document.querySelectorAll(role.sel).forEach(el => {
      if (role.lock){ el.style.setProperty('--fs', role.lock); return; }
      const longest = widestLine(el, role.max);
      if (!longest) return;
      const fs = Math.min(role.max, role.max * el.clientWidth / longest);
      el.style.setProperty('--fs', Math.max(role.min, Math.floor(fs * 2) / 2));
    });
  }
});
</script>

</body>
</html>
